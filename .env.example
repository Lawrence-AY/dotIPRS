NODE_ENV=development
PORT=3000

AUTH_SESSION_USERNAME=your-session-username
AUTH_SESSION_PASSWORD=your-session-password
AUTH_SESSION_SECRET=replace-with-long-random-secret
AUTH_SESSION_TTL_SECONDS=3600
AUTH_SESSION_USER_ID=11111111-1111-4111-8111-111111111111
AUTH_SESSION_ROLE=SACCO_ADMIN

DATABASE_URL=postgres://postgres:postgres@localhost:5432/sacco_iprs

IPRS_ENABLED=true
IPRS_PROVIDER=mock
IPRS_ENVIRONMENT=uat
IPRS_WSDL_URL=http://10.10.13.5:9004/IPRSServerwcf?wsdl
IPRS_USERNAME=your-iprs-username
IPRS_PASSWORD=your-iprs-password
IPRS_TIMEOUT=30000
IPRS_SOAP_VERSION=1.1
IPRS_VERIFY_SSL=true
IPRS_MAX_RETRIES=2
IPRS_RETRY_DELAY=1000
IPRS_RATE_LIMIT_WINDOW_MS=60000
IPRS_RATE_LIMIT_MAX=30
IPRS_ALLOWED_OPERATIONS=Login,GetDataByIdCard,GetDataByPin,GetDataByPassport,GetDataByBirthCertificate,GetDataByDeathCertificate,GetDataByAlienCard,VerificationByIDCard,VerificationByPassport,VerificationByAlienCard
IPRS_IDENTIFIER_HASH_SECRET=replace-with-long-random-secret
IPRS_AUDIT_ENABLED=true
